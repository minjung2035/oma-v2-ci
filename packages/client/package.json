{
  "name": "@oma/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./receipts": {
      "types": "./dist/receipts.d.ts",
      "default": "./dist/receipts.js"
    },
    "./request-service": {
      "types": "./dist/request-service.d.ts",
      "default": "./dist/request-service.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "default": "./dist/connection.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-workspaces.mjs @oma/client",
    "typecheck": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@oma/contracts": "0.1.0",
    "@oma/protocol": "0.1.0",
    "@oma/domain": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "5.9.3"
  }
}
