<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MAC-701: the Keychain group is granted by the embedded Developer ID
     provisioning profile; the identifier is fixed by Q4; the Team ID is the signer's. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.virtualization</key>
  <true/>
  <key>keychain-access-groups</key>
  <array>
    <string>$(TeamIdentifierPrefix)io.github.minjung2035.oma</string>
  </array>
</dict>
</plist>
