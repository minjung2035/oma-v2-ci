{
  "name": "@oma/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ask-user-question": {
      "types": "./dist/ask-user-question.d.ts",
      "default": "./dist/ask-user-question.js"
    },
    "./delivery": {
      "types": "./dist/delivery.d.ts",
      "default": "./dist/delivery.js"
    },
    "./mail-tools": {
      "types": "./dist/mail-tools.d.ts",
      "default": "./dist/mail-tools.js"
    },
    "./principal-channel": {
      "types": "./dist/principal-channel.d.ts",
      "default": "./dist/principal-channel.js"
    },
    "./principal-tools": {
      "types": "./dist/principal-tools.d.ts",
      "default": "./dist/principal-tools.js"
    },
    "./prompt-boundary": {
      "types": "./dist/prompt-boundary.d.ts",
      "default": "./dist/prompt-boundary.js"
    },
    "./egress-bridge": {
      "types": "./dist/egress-bridge.d.ts",
      "default": "./dist/egress-bridge.js"
    },
    "./inference-bridge": {
      "types": "./dist/inference-bridge.d.ts",
      "default": "./dist/inference-bridge.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-workspaces.mjs @oma/extension",
    "typecheck": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@oma/contracts": "0.1.0",
    "@oma/domain": "0.1.0",
    "@oma/protocol": "0.1.0",
    "@oma/client": "0.1.0",
    "@oma/tool-runtime": "0.1.0",
    "@oma/tool-lsp": "0.1.0",
    "@oma/tool-hashline": "0.1.0",
    "@oma/tool-web": "0.1.0",
    "@oma/tool-mcp": "0.1.0",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "5.9.3"
  },
  "oma": {
    "isolationSmoke": "test/installed-runtime.mjs"
