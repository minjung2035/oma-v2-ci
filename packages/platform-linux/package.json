    },
    "./sandbox-seccomp": {
      "types": "./dist/sandbox-seccomp.d.ts",
      "default": "./dist/sandbox-seccomp.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "default": "./dist/units.js"
    },
    "./units/execute": {
