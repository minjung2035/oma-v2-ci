      "default": "./dist/units/execute.js"
    },
    "./units/observe": {
      "types": "./dist/units/observe.d.ts",
      "default": "./dist/units/observe.js"
    },
    "./units/render": {
      "types": "./dist/units/render.d.ts",
      "default": "./dist/units/render.js"
    }
