# One host connection to guesthost. Not as the oma user: guesthost answers
# the bridge's uid alone (SO_PEERCRED), because any process of the oma user --
# an engine outside its sandbox included -- could open a socket that user
# owns (MAC-202, FS-005).
[Unit]
Description=OMA guest society connection
Requires=oma-guesthost.service
After=oma-guesthost.service

[Service]
User=oma-bridge
Group=oma-bridge
ExecStart=/usr/lib/oma/bin/oma-vsock-bridge /run/oma-guesthost/society.sock
StandardInput=null
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_VSOCK
