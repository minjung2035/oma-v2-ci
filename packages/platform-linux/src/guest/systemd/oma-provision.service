# MAC-303: the data disk is made once, only when handed over to be made, and
# mounted only if it says it is this engine instance's. The services that use
# it start only after this succeeded.
[Unit]
Description=OMA data disk
DefaultDependencies=no
After=local-fs-pre.target systemd-udev-settle.service
Before=oma-guestctl.service oma-guesthost.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/oma/node/bin/node /usr/lib/oma/apps/oma/dist/entry/guest-provision.js --device /dev/vdc --mount /var/lib/oma
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=yes

[Install]
RequiredBy=oma-guestctl.service oma-guesthost.service
