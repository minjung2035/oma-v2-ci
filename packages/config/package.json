{
  "name": "@oma/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "default": "./dist/defaults.js"
    },
    "./generations": {
      "types": "./dist/generations.d.ts",
      "default": "./dist/generations.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-workspaces.mjs @oma/config",
    "typecheck": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@oma/contracts": "0.1.0",
    "@oma/domain": "0.1.0",
    "@oma/protocol": "0.1.0",
    "@oma/native": "0.1.0",
    "@oma/file-descriptors": "0.1.0",
    "@oma/storage": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "5.9.3"
  }
}
