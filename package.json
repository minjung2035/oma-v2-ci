{
  "name": "oma-core-v1",
  "version": "0.1.0",
  "private": true,
  "description": "OMA Core v1 \u2014 Principal + Unix mailing-list society + Git (docs/architecture.md is source of truth)",
  "type": "module",
  "bin": {
    "oma": "apps/oma/dist/entry/oma.js"
  },
  "license": "UNLICENSED",
  "scripts": {
    "setup:storage": "node scripts/install-restic.mjs",
    "build": "node scripts/build.mjs",
    "build:tui": "npm run build --workspace @oma/tui",
    "build:extension": "npm run build --workspace @oma/extension",
    "typecheck": "npm run build:workspaces && tsc -p tsconfig.json --noEmit",
    "config:split": "npm run build && node scripts/split-operations-config.mjs",
    "config:export": "npm run build && node scripts/export-operations-config.mjs",
    "review:ledger": "node scripts/review-ledger.mjs",
    "inventory": "node scripts/loc.mjs --inventory-only",
    "mutation:locality": "node scripts/mutation-locality.mjs",
    "check:inventory": "node scripts/production-inventory.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:transactions": "node scripts/transaction-check.mjs",
    "check:architecture:rules": "node scripts/architecture/rule-check.mjs",
    "check:architecture": "npm run check:modules && npm run check:legacy && npm run check:inventory && npm run check:architecture:rules && node scripts/architecture-check.mjs && npm run check:transactions && npm run check:boundaries && npm run check:documents && npm run check:spec-inventory",
    "test": "npm run build && node scripts/test-local.mjs",
    "test:functional-pi": "npm run build && node scripts/functional-pi-smoke.mjs",
    "verify:lane": "node scripts/verify-lane.mjs",
    "verify:fast": "node scripts/verify-lane.mjs fast",
    "verify:durable": "node scripts/verify-lane.mjs durable",
    "verify:kernel": "node scripts/verify-lane.mjs kernel",
    "verify:crash": "node scripts/verify-lane.mjs crash",
    "verify:property": "node scripts/verify-lane.mjs property",
    "verify:stress": "node scripts/verify-lane.mjs stress",
    "verify:platform": "node scripts/verify-lane.mjs platform",
    "verify:all": "node scripts/verify-lane.mjs all",
    "evidence:graph": "node scripts/dependency-graph.mjs --write-evidence",
    "evidence:refresh": "node scripts/refresh-evidence.mjs",
    "verify:powercut": "node scripts/powercut-lane.mjs",
    "verify:powercut:simulation": "npm run build && node --test test/powercut-lane.test.mjs",
    "test:functional-surface": "npm run build && node scripts/functional-surface.mjs",
    "check:boundaries": "node scripts/durable-boundaries.mjs",
    "check:documents": "node scripts/document-integrity.mjs",
    "check:spec-inventory": "node scripts/spec-inventory.mjs",
    "build:workspaces": "node scripts/build-workspaces.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "check:package-isolation": "node scripts/check-package-isolation.mjs",
    "test:workspaces": "npm run test --workspaces --if-present",
    "check:legacy": "node scripts/check-legacy.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/nodemailer": "8.0.1",
    "typescript": "5.9.3",
    "nodemailer": "10.0.16",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "koffi": "^3.2.1",
    "pi-open-tui": "0.3.11",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "@oma/broker": "0.1.0",
    "@oma/client": "0.1.0",
    "@oma/config": "0.1.0",
    "@oma/contracts": "0.1.0",
    "@oma/domain": "0.1.0",
    "@oma/engine": "0.1.0",
    "@oma/extension": "0.1.0",
    "@oma/git": "0.1.0",
    "@oma/lifecycle": "0.1.0",
    "@oma/mail": "0.1.0",
    "@oma/native": "0.1.0",
    "@oma/file-descriptors": "0.1.0",
    "@oma/platform-linux": "0.1.0",
    "@oma/platform-mac": "0.1.0",
    "@oma/process": "0.1.0",
    "@oma/protocol": "0.1.0",
    "@oma/reconcile": "0.1.0",
    "@oma/review": "0.1.0",
    "@oma/storage": "0.1.0",
    "@oma/tool-hashline": "0.1.0",
    "@oma/tool-lsp": "0.1.0",
    "@oma/tool-mcp": "0.1.0",
    "@oma/tool-runtime": "0.1.0",
    "@oma/tool-web": "0.1.0",
    "@oma/tui": "0.1.0",
    "@types/proper-lockfile": "4.1.4",
    "@oma/tool-files": "0.1.0"
  },
  "dependencies": {
    "@oma/app": "0.1.0"
  },
  "allowScripts": {
    "koffi@3.2.1": true
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "imports": {
    "#oma-test/app/*": {
      "types": "./apps/oma/dist/*.d.ts",
      "default": "./apps/oma/dist/*.js"
    }
  }
}
