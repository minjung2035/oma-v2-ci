# One host connection to guestctl. The bridge runs as its own user: guestctl
# answers that uid alone (SO_PEERCRED), so nothing else in the guest can pose
# as the host by opening guestctl's socket (MAC-202, FS-005).
[Unit]
Description=OMA guest control connection
Requires=oma-guestctl.service
After=oma-guestctl.service

[Service]
User=oma-bridge
Group=oma-bridge
ExecStart=/usr/lib/oma/bin/oma-vsock-bridge /run/oma-guestctl/control.sock
StandardInput=null
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_VSOCK
