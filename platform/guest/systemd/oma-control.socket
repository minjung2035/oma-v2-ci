# MAC-202: the host's control channel. systemd binds the reserved vsock port
# (only it holds CAP_NET_BIND_SERVICE in the guest) and starts one bridge per
# connection; the bridge refuses every peer but the host (CID 2).
[Unit]
Description=OMA guest control port

[Socket]
ListenStream=vsock::700
Accept=yes
MaxConnections=8

[Install]
WantedBy=sockets.target
