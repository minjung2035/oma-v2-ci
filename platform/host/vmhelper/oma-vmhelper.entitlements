<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MAC-701: the Keychain group is granted by the embedded Developer ID
     provisioning profile; <TeamID> and <vendor> are the distributor's (Q4). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.virtualization</key>
  <true/>
  <key>keychain-access-groups</key>
  <array>
    <string>$(TeamIdentifierPrefix)com.vendor.oma</string>
  </array>
</dict>
</plist>
