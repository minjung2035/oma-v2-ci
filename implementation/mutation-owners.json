        { "path": "src/storage/context-snapshot.ts", "symbol": "context snapshot persistence" },
        { "path": "src/storage/operation-journal.ts", "symbol": "accepted operation journal" }
      ],
      "recovery": {
        "strategy": "physical-replay",
        "owners": [
          { "path": "src/git/context.ts", "symbol": "ContextCoordinator.reconcile" }
        ]
      },
      "cli": [
        { "path": "src/cli/commands/context.ts", "symbol": "runContextCommand" }
      ],
      "tests": [
        { "path": "test/r21-context-workflow.test.ts", "symbol": "context workflow" },
        { "path": "test/context-publication-durability.test.ts", "symbol": "context durability" },
        { "path": "test/context-recovery-corruption-oracle.test.ts", "symbol": "context recovery corruption" },
