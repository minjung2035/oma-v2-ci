{
  "version": 1,
  "purpose": "Predictable AI change locality for durable public mutations. Central registries stay centralized; symbol metadata narrows the read surface.",
  "registryOwners": {
    "wire": {
      "path": "packages/contracts/src/public-wire.ts",
      "symbolTemplate": "PublicMethods[\"{mutation}\"]"
    },
    "validation": {
      "path": "packages/domain/src/validation.ts",
      "symbolFromMethod": "paramsCheck"
    },
    "method": {
      "path": "packages/protocol/src/methods.ts",
      "symbolTemplate": "PUBLIC_METHODS[\"{mutation}\"]"
    },
    "durableContract": {
      "path": "packages/contracts/src/durable.ts",
      "symbolTemplate": "OperationPlan/OperationResult variant \"{mutation}\""
    },
    "durable": {
      "path": "packages/domain/src/durable.ts",
      "symbolTemplate": "checks[\"{mutation}\"] + operationPlanCheck case \"{mutation}\""
    },
    "resultRelation": {
      "path": "packages/domain/src/durable.ts",
      "symbolTemplate": "operationResultRelationCheck case \"{mutation}\""
    },
    "codec": {
      "path": "packages/protocol/src/operation-codec.ts",
      "symbolTemplate": "DecodedOperation variant \"{mutation}\""
    },
    "dispatch": {
      "path": "packages/broker/src/public-dispatcher.ts",
      "symbolTemplate": "PublicDispatcher.dispatchChecked case \"{mutation}\""
    }
  },
  "requiredMutationDimensions": [
    "workflow",
    "persistence",
    "recovery",
    "cli",
    "tests"
  ],
  "recoveryStrategies": {
    "physical-replay": "accepted work may require idempotent physical replay after commit/crash",
    "transaction-complete": "the mutation is completed inside its acceptance transaction; no physical recovery handler is expected"
  },
  "fanoutStages": [
    "wire",
    "validation",
    "method",
    "durableContract",
    "durable",
    "codec",
    "dispatch",
    "tests"
  ],
