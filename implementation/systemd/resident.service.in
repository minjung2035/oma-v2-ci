# MUST [UNIT-001..004]: Resource values are rendered from the broker-resolved host profile.
[Unit]
Description=OMA @SOCIETY@ resident @AGENT@
BindsTo=oma-@SOCIETY@-broker.service
After=oma-@SOCIETY@-broker.service
StartLimitIntervalSec=60s
StartLimitBurst=5
[Service]
Type=exec
Environment=OMA_PROFILE_HEX=@PROFILE_HEX@
ExecStart=@NODE@ @LIBDIR@/dist/entry/runner.js --society @SOCIETY@ --agent @AGENT@
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStopSec=10s
MemoryMax=@MEMORY_BYTES@
TasksMax=@TASKS@
CPUQuota=@CPU_QUOTA@%
OOMPolicy=kill
UMask=0077
StandardOutput=journal
StandardError=journal
