# MUST [REC-002]: Reference interval, not periodic inference.
[Unit]
Description=Periodic physical reconciliation for OMA @SOCIETY@
# P0V-59: the state tree this unit belongs to; systemd ignores X- keys.
X-OMA-Owner=@STATE@
[Timer]
OnStartupSec=5s
OnUnitActiveSec=5s
AccuracySec=1s
Unit=oma-@SOCIETY@-reconcile.service
[Install]
WantedBy=timers.target
