# MUST [UNIT-001..004]: Render trusted placeholders; never install .in directly.
[Unit]
Description=OMA @SOCIETY@ broker
# P0V-59: the state tree this unit belongs to; systemd ignores X- keys.
X-OMA-Owner=@STATE@
StartLimitIntervalSec=60s
StartLimitBurst=5
[Service]
Type=notify
NotifyAccess=main
ExecStart=@NODE@ @LIBDIR@/dist/src/entry/broker.js --society @SOCIETY@
Restart=on-failure
# DR27: bound crash pressure without bypassing the five-start/60s breaker.
RestartSec=3s
RestartSteps=4
RestartMaxDelaySec=12s
KillMode=control-group
TimeoutStopSec=15s
UMask=0077
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=default.target
